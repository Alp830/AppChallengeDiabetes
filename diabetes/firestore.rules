rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, create, update, delete: if isOwner(userId);

      match /fridgeItems/{itemId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /workoutSessions/{sessionId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /workoutPlans/{planId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /exerciseProfile/{profileId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /exerciseReminders/{reminderId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /dailyTodos/{dayId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /glucoseDays/{dayId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /glucoseImports/{importId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /glucoseSettings/{settingsId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /mealEvents/{mealId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /mealTemplates/{templateId} {
        allow read, create, update, delete: if isOwner(userId);
      }

      match /mealGroups/{groupId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }
  }
}
